{
    "extends": [
      "stylelint-config-standard"
    ],
    "plugins": [
      "stylelint-order"
    ],
    "rules": {
      "order/properties-alphabetical-order": true,
      "at-rule-no-unknown": [
        true,
        {
          "ignoreAtRules": [
            "tailwind",
            "apply",
            "variants",
            "responsive",
            "screen", 
            "use",
            "include",
            "mixin"
          ]
        }
      ],
      "no-descending-specificity": null,
      "selector-class-pattern": null, 
      "no-invalid-position-at-import-rule": null
    }
  }
  